generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  role          Role     @default(USER)
  emailVerified Boolean  @default(false)
  refreshToken  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  verificationTokens VerificationToken[]
  userSources        UserSource[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      VerificationTokenType
  // храним только sha256-хэш токена, plain-токен уходит пользователю в письме
  tokenHash String                @unique
  expiresAt DateTime
  createdAt DateTime              @default(now())

  @@index([userId, type])
  @@map("verification_tokens")
}

// Значения зеркалят Zod-схему AuditEventSchema в @repo/types (source of truth).
// Prisma-enum не может импортировать из пакета, поэтому список сверяется вручную.
enum AuditEvent {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGOUT
  USER_ROLE_CHANGED
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
}

model AuditLog {
  id         String     @id @default(cuid())
  event      AuditEvent
  success    Boolean    @default(true)
  // actorId/targetId без FK на User: журнал переживает удаление пользователя
  actorId    String?
  actorEmail String? // денормализованный email актора для отображения без join
  targetId   String?
  targetType String? // тип целевой сущности ("User")
  metadata   Json? // только whitelisted поля (без паролей/токенов)
  ip         String?
  userAgent  String?
  createdAt  DateTime   @default(now())

  @@index([createdAt])
  @@index([event])
  @@index([actorId])
  @@map("audit_logs")
}

enum SourceType {
  RSS
  TELEGRAM
}

// Глобальный справочник источников — один фетчер на URL, переиспользуется всеми подписчиками.
model Source {
  id            String     @id @default(cuid())
  type          SourceType
  url           String     @unique
  // Часть фидов не отдаёт <title> канала — fallback на хост URL в SourcesService.
  title         String
  lastFetchedAt DateTime?
  createdAt     DateTime   @default(now())

  subscriptions UserSource[]
  articles      Article[]

  @@map("sources")
}

// Подписка пользователя на источник. Составной ключ вместо id — подписка не существует
// без обеих сторон, отдельный идентификатор не нужен.
model UserSource {
  userId    String
  sourceId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([userId, sourceId])
  @@map("user_sources")
}

model Article {
  id         String   @id @default(cuid())
  sourceId   String
  // guid ?? link из фида — дедупликация статей одного источника при повторном парсинге.
  externalId String
  title      String
  url        String
  // Nullable: у многих RSS/Atom-элементов нет pubDate/isoDate.
  publishedAt DateTime?
  fetchedAt  DateTime @default(now())

  source Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalId])
  @@index([publishedAt])
  @@map("articles")
}
