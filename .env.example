# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recommends?schema=public"

# JWT
JWT_SECRET="change-me-jwt-secret-min-32-chars-long"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Next Auth
NEXTAUTH_SECRET="change-me-nextauth-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# API
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Internal API URL for server-side requests (Docker: http://api:3001)
API_URL="http://localhost:3001"

# Mailer
# json — dev-режим (письма логируются, реальный SMTP не нужен); smtp — реальная отправка
MAIL_TRANSPORT="json"
MAIL_FROM="no-reply@example.com"
# SMTP_* обязательны только при MAIL_TRANSPORT=smtp
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Базовый URL веб-приложения для ссылок в письмах
WEB_URL="http://localhost:3000"
# TTL одноразовых токенов: <число><s|m|h|d|w>
EMAIL_VERIFICATION_TTL="24h"
PASSWORD_RESET_TTL="1h"
# Базовый URL публичной preview-страницы Telegram (для HTTP-scraping каналов)
TELEGRAM_PREVIEW_BASE_URL="https://t.me"
# Для e2e (apps/web/e2e/telegram-source.spec.ts): перед прогоном перезапустить API-процесс с
# TELEGRAM_PREVIEW_BASE_URL="http://127.0.0.1:4310" — переменная кешируется getEnv() один раз при
# старте API, поэтому mock-сервер слушает фиксированный порт 4310, а не listen(0) (аналогично
# NODE_ENV=test для email-verification e2e, см. комментарий в apps/web/playwright.config.ts)
# Если API запущен в Docker (docker-compose), для обоих e2e-моков (RSS и Telegram) нужно
# передавать адрес docker-моста хоста вместо 127.0.0.1: TELEGRAM_PREVIEW_BASE_URL и
# E2E_RSS_FEED_HOST (см. apps/web/e2e/sources.spec.ts) — например "172.17.0.1" или адрес
# из `docker network inspect`.

# Docker / Production (не нужны для локальной разработки)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD=""
POSTGRES_DB="nexst"
REDIS_PASSWORD=""
